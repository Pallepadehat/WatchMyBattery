    "%@ is using a lot of energy" : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ bruger meget energi"
          }
        }
      }
    },
    "%@ is using the most energy." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ bruger mest energi."
          }
        }
      }
    },
    "%@ is using the most energy. Quitting it would give you about %@ more." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ bruger mest energi. Hvis du afslutter appen, får du ca. %@ mere."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ is using the most energy. Quitting it would give you about %2$@ more."

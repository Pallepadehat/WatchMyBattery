    "Get Battery Time Left" : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hent batteritid tilbage"
          }
        }
      }
    },
    "Gets how long the battery will last, or how long until it's full while charging. Empty while macOS is still calculating, or when the Mac is plugged in and not charging." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Henter, hvor længe batteriet holder, eller hvor længe der er, til det er fuldt, mens det oplades. Tom, mens macOS stadig beregner, eller når Mac'en er tilsluttet strøm og ikke oplader."
          }
        }
      }
    },
    "Gets the battery's charge, as a percentage from 0 to 100." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Henter batteriets opladning som en procentdel fra 0 til 100."
          }
        }
      }
    },
    "Green while charging, yellow in Low Power Mode, red when low." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grøn under opladning, gul i strømsparetilstand, rød når det er lavt."
          }
        }
      }
    },

            "value" : "Indsigter"
          }
        }
      }
    },
    "Insights also show in the panel. They're worked out on this Mac, from what WatchMyBattery already measures." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indsigter vises også i panelet. De udregnes på denne Mac ud fra det, WatchMyBattery allerede måler."
          }
        }
      }
    },
    "Install" : {
      "localizations" : {
        "da" : {

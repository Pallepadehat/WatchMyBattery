    "AirPods, Beats and other headphones, the Magic Mouse, Keyboard and Trackpad, and game controllers." : {
      "extractionState" : "stale",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AirPods, Beats og andre hovedtelefoner, Magic Mouse, Keyboard og Trackpad samt spillecontrollere."
          }
        }
      }
    },
    "AirPods, Beats and other headphones, the Magic Mouse, Keyboard and Trackpad, game controllers, and your iPhone and iPad." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AirPods, Beats og andre hovedtelefoner, Magic Mouse, Keyboard og Trackpad, spillecontrollere samt din iPhone og iPad."
          }
        }
      }
    },
    "Allow…" : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillad…"
          }
        }
      }
    },
    "Allowed" : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilladt"
          }
        }
      }
    },
    "An Apple Watch only talks to its iPhone, so a Mac can't read its battery." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et Apple Watch taler kun med sin iPhone, så en Mac kan ikke læse dets batteri."
          }
        }
      }
    },
    "Another app uses this shortcut. Choose a different one." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En anden app bruger denne genvej. Vælg en anden."
          }
        }
      }
    },
    "Apps" : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apps"
          }
        }
      }
    },
    "Apps are measured every few minutes while on battery, and show up here." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apps måles med få minutters mellemrum, mens Mac'en kører på batteri, og vises her."
          }
        }
      }
    },
    "Apps ask macOS not to sleep to finish a download, play something, or keep a call going. One that forgets to stop keeps the Mac awake with the lid closed, or long after you've walked away." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apps beder macOS om ikke at gå i dvale for at gøre en download færdig, afspille noget eller holde et opkald i gang. En app, der glemmer at stoppe, holder Mac'en vågen med låget lukket, eller længe efter du er gået."
          }
        }
      }
    },
    "Apps Shown" : {
      "localizations" : {

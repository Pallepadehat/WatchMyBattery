      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan tage strømmen fra din Mac."
          }
        }
      }
    },
    "Your %@ limit comes back when you unplug." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din grænse på %@ kommer tilbage, når du tager strømmen fra."
          }
        }
      }
    },
    "Your battery, and who's draining it." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit batteri, og hvem der dræner det."
          }
        }
      }
    },
    "Your charge limit keeps the battery at %@, so it lasts longer. The Mac runs from the adapter once it's there." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din opladningsgrænse holder batteriet på %@, så det holder længere. Mac'en kører på strømforsyningen, når den er nået."
          }
        }
      }
    },
    "Your charge limit stops charging at %@, so the notification comes then." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din opladningsgrænse stopper opladningen ved %@, så notifikationen kommer der."

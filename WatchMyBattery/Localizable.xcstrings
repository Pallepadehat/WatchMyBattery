{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ before" : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ før"
          }
        }
      }
    },
    "%@ is new, and using a lot of battery" : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ er ny og bruger meget batteri"
          }
        }
      }
    },
    "%@ on battery · %@ used" : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ på batteri · %2$@ brugt"
          }
        }
      }
    },
    "%@ · MIT License" : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · MIT-licens"
          }
        }
      }
    },
    "%@ an hour" : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ i timen"
          }
        }
      }
    },
    "%@ didn't quit" : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ blev ikke afsluttet"
          }
        }

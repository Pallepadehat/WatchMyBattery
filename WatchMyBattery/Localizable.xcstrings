    "%@ W going into the battery." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ W går ind i batteriet."
          }
        }
      }
    },
    "%@ will close. If it has unsaved changes, it will ask what to do with them." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ lukkes. Hvis der er ændringer, der ikke er arkiveret, spørger appen, hvad der skal ske med dem."
          }
        }
      }
    },
    "%@. Put them in their case to charge." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Læg dem i etuiet for at oplade dem."
          }
        }
      }
    },

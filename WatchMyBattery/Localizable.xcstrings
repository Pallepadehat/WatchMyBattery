      }
    },
    "Optimized Battery Charging keeps the battery at %@ for now, so it lasts longer, and finishes charging in time for when you usually unplug." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optimeret batteriopladning holder batteriet på %@ indtil videre, så det holder længere, og lader færdigt i god tid til, når du plejer at tage stikket ud."
          }
        }
      }
    },
    "Over the days the Mac ran on battery. Time on battery includes time asleep." : {

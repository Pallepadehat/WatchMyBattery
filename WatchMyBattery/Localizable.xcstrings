    "What the battery controller measures right now." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvad batteriets controller måler lige nu."
          }
        }
      }
    },
    "What the battery controller measures, under the battery." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvad batteriets controller måler, under batteriet."
          }
        }

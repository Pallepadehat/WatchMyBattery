    "10 Days" : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "10 dage"
          }
        }
      }
    },
    "24 Hours" : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "24 timer"
          }
        }
      }
    },
    "A line in the panel when the battery won't last through a meeting, the Mac uses more power than usual, or a new app uses a lot." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En linje i panelet, når batteriet ikke holder et møde igennem, Mac'en bruger mere strøm end normalt, eller en ny app bruger meget."
          }
        }
      }
    },
    "A notification naming the app using the most energy, with a button to quit it." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En notifikation, der nævner den app, der bruger mest energi, med en knap til at afslutte den."
          }
        }
      }
    },
    "A notification when an app keeps using a lot of power on battery for a while, with a button to quit it. Not for the app you're using." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En notifikation, når en app bliver ved med at bruge meget strøm på batteri, med en knap til at afslutte den. Ikke for den app, du bruger."
          }
        }
      }
    },
    "A soft glow flows into the battery while it charges, here and in the panel." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et blødt lys strømmer ind i batteriet, mens det oplader, her og i panelet."
          }
        }
      }
    },

    "About %@%% an hour." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ca. %@ %% i timen."
          }
        }
      }
    },
    "About %lld times as much as at this time on most days, mostly because of %@." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ca. %1$lld gange så meget som på dette tidspunkt de fleste dage, mest på grund af %2$@."
          }
        }
      }
    },
    "About %lld times as much as at this time on most days." : {
      "localizations" : {

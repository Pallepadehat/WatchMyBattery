{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ didn't quit" : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ blev ikke afsluttet"
          }
        }
      }
    },
    "%@ is using the most energy." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ bruger mest energi."
          }
        }
      }
    },
    "%@ is using the most energy. Quitting it would give you about %@ more." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ bruger mest energi. Hvis du afslutter appen, får du ca. %@ mere."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ is using the most energy. Quitting it would give you about %2$@ more."
          }
        }
      }
    },
    "%@ will close. If it has unsaved changes, it will ask what to do with them." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ lukkes. Hvis der er ændringer, der ikke er arkiveret, spørger appen, hvad der skal ske med dem."
          }
        }
      }
    },
    "%@ · MIT License" : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · MIT-licens"
          }
        }
      }
    },
    "%lld cycles" : {
      "localizations" : {
        "da" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld cyklus"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld cyklusser"
                }
              }
            }
          }
        },
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld cycle"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld cycles"
                }
              }
            }
          }
        }
      }
    },
    "A notification naming the app using the most energy, with a button to quit it." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En notifikation, der nævner den app, der bruger mest energi, med en knap til at afslutte den."
          }
        }
      }
    },
    "A soft glow flows into the battery while it charges, here and in the panel." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et blødt lys strømmer ind i batteriet, mens det oplader, her og i panelet."
          }
        }
      }
    },

    },
    "What's New" : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nyheder"
          }
        }
      }
    },
    "When an app that hadn't used much battery in the last two weeks is now among the hungriest." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når en app, der ikke har brugt meget batteri de seneste to uger, nu er blandt de mest strømslugende."
          }
        }
      }
    },
    "When Headphones Connect" : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når hovedtelefoner forbindes"
          }
        }
      }
    },
    "When It's Charged" : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når det er opladet"
          }
        }
      }
    },
    "When the battery won't last through your next meeting. Uses the Calendar app, and only reads when events start and end." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når batteriet ikke holder dit næste møde igennem. Bruger appen Kalender og læser kun, hvornår begivenheder starter og slutter."
          }
        }
      }
    },
    "When the Mac uses clearly more power than it usually does at this time of day, and which app is behind it. Once it knows what's usual, after about a week." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når Mac'en bruger tydeligt mere strøm, end den plejer på dette tidspunkt af dagen, og hvilken app der står bag. Når den ved, hvad der er normalt, efter ca. en uge."
          }
        }
      }
    },
    "When you drag an app out of the battery. Delete on a selected slice always asks." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du trækker en app ud af batteriet. Slet på en valgt bid spørger altid."
          }
        }
      }
    },

    "Get Started" : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kom i gang"
          }
        }
      }
    },
    "Gets how long the battery will last, or how long until it's full while charging. Empty while macOS is still calculating, or when the Mac is plugged in and not charging." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Henter, hvor længe batteriet holder, eller hvor længe der er, til det er fuldt, mens det oplades. Tom, mens macOS stadig beregner, eller når Mac'en er tilsluttet strøm og ikke oplader."
          }
        }
      }
    },
    "Gets the battery's charge, as a percentage from 0 to 100." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Henter batteriets opladning som en procentdel fra 0 til 100."
          }
        }
      }
    },
    "Gets when the battery should reach 20%, at the pace the Mac is going now and the way the battery usually goes later in the day. Empty while plugged in, or when it won't get that low in the next 12 hours." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Henter, hvornår batteriet ventes at nå 20 %, i det tempo Mac'en kører i nu, og som batteriet plejer at gå senere på dagen. Tom, mens den er tilsluttet, eller når det ikke kommer så langt ned inden for 12 timer."
          }
        }
      }
    },
    "Glass" : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glas"
          }
        }
      }
    },
    "Green charging, yellow in Low Power Mode, red when low." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grøn under opladning, gul i strømsparetilstand, rød når det er lavt."

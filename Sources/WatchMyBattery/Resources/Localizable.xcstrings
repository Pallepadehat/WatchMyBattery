        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stille vand"
          }
        }
      }
    },
    "Stops charging at %@ while plugged in, so the battery lasts longer." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stopper opladningen ved %@, mens strømmen er tilsluttet, så batteriet holder længere."
          }
        }
      }
    },
    "Storage" : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lagring"
          }
        }
      }
    },
    "Stripes" : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Striber"
          }
        }
      }
    },
    "Stripes glide through the part still to charge." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Striber glider gennem den del, der mangler at blive opladet."
          }
        }
      }
    },
    "Style" : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stil"
          }
        }
      }
    },
    "Syncing files and data with iCloud." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synkroniserer filer og data med iCloud."
          }
        }
      }
    },
    "System Default" : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Systemets standard"
          }
        }
      }
    },
    "Talking to your Bluetooth keyboard, mouse, headphones and other devices." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taler med dit Bluetooth-tastatur, din mus, dine hovedtelefoner og andre enheder."
          }
        }
      }
    },
    "Temperature" : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temperatur"
          }
        }
      }
    },
    "Temperature, Voltage and Current" : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temperatur, spænding og strøm"
          }
        }
      }
    },
    "Ten days of battery, and a heads-up when something's unusual." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ti dages batteri, og besked, når noget er usædvanligt."
          }
        }
      }
    },
    "Text" : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekst"
          }
        }
      }
    },
    "Text Only" : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun tekst"
          }
        }
      }
    },
    "than the 2 weeks before" : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "end de 2 uger før"
          }
        }
      }
    },
    "than the 3 months before" : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "end de 3 måneder før"
          }
        }
      }
    },
    "than the month before" : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "end måneden før"
          }
        }
      }
    },
    "than the week before" : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "end ugen før"
          }
        }
      }
    },
    "than the year before" : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "end året før"
          }
        }
      }
    },
    "That's fine with a limit: the battery rests while the Mac runs from the charger." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det er fint med en grænse: batteriet hviler, mens Mac'en kører på opladeren."
          }
        }
      }
    },
    "The apps using the most energy each get a slice." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De apps, der bruger mest energi, får hver en bid."
          }
        }
      }
    },
    "The apps, in the battery" : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apps, i batteriet"
          }
        }
      }
    },
    "The battery can move while it charges, and while it's held at your limit." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Batteriet kan bevæge sig, mens det oplader, og mens det holdes ved din grænse."
          }
        }
      }
    },
    "The battery is at %@ and charging." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Batteriet er på %@ og oplades."
          }
        }
      }
    },
    "The battery is at %@." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Batteriet er på %@."
          }
        }
      }
    },
    "The battery is fully charged." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Batteriet er fuldt opladet."
          }
        }
      }
    },
    "The battery is hot: macOS slows or pauses charging until it cools down." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Batteriet er varmt: macOS sænker eller sætter opladningen på pause, til det er kølet af."
          }
        }
      }
    },
    "The battery is running down, though your Mac isn't using more than the charger should give. Another cable or port, or plugging the charger straight into the Mac, usually helps." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Batteriet aflades, selvom din Mac ikke bruger mere, end opladeren burde kunne give. Et andet kabel eller en anden port, eller at sætte opladeren direkte i Mac’en, hjælper som regel."
          }
        }
      }
    },
    "The battery is warm. Time spent warm wears it a little faster." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Batteriet er lunt. Tid som lunt slider det lidt hurtigere."
          }
        }
      }
    },
    "The battery level and the apps that used it, hour by hour, for as long as you keep it. Apps are measured every few minutes while on battery, and the history stays on this Mac." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Batteriniveauet og de apps, der brugte det, time for time, så længe du gemmer det. Apps måles med få minutters mellemrum på batteri, og historikken bliver på denne Mac."
          }
        }
      }
    },
    "The battery level shows here as it changes." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Batteriniveauet vises her, efterhånden som det ændrer sig."
          }
        }
      }
    },
    "The battery moves while it charges and while it's held, here and in the panel." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Batteriet bevæger sig, mens det oplader, og mens opladningen holdes, her og i panelet."
          }
        }
      }
    },
    "The battery should last at least another 12 hours." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Batteriet ventes at holde mindst 12 timer endnu."
          }
        }
      }
    },
    "The battery should last until about %@, and the meeting runs until %@." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Batteriet bør holde til ca. kl. %1$@, og mødet varer til kl. %2$@."
          }
        }
      }
    },
    "The battery should last until about %@." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Batteriet bør holde til ca. kl. %@."
          }
        }
      }
    },
    "The battery should reach 20%% around %@." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Batteriet ventes at nå 20 %% omkring kl. %@."
          }
        }
      }
    },
    "The battery should run out around %@." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Batteriet ventes at løbe tør omkring kl. %@."
          }
        }
      }
    },
    "The battery's health is read once a day. Its line starts with the first reading." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Batteriets tilstand måles én gang om dagen. Linjen begynder med den første måling."
          }
        }
      }
    },
    "The battery's maximum capacity against when it was new, and its charge cycles: a cycle is a full battery used, in one go or over several days. Read once a day from macOS's own figures, and kept for good, so you can see the battery wear over the years." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Batteriets maksimale kapacitet i forhold til som nyt, og dets opladningscyklusser: en cyklus er et helt batteri brugt, på én gang eller over flere dage. Måles én gang om dagen ud fra macOS’ egne tal og gemmes for altid, så du kan se batteriet slides over årene."
          }
        }
      }
    },
    "The battery's own temperature, from its sensors. Around 35 °C while charging is normal. From 38 °C, charging slows down and time spent this warm wears a battery faster; from 40 °C, macOS holds back charging. Keeping the Mac out of the sun and off soft surfaces while it charges helps." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Batteriets egen temperatur, fra dets sensorer. Omkring 35 °C under opladning er normalt. Fra 38 °C går opladningen langsommere, og tid så varm slider batteriet hurtigere; fra 40 °C holder macOS opladningen tilbage. Det hjælper at holde Mac’en ude af solen og væk fra bløde underlag, mens den oplader."
          }
        }
      }
    },
    "The battery's own temperature. Around 35 °C while charging is normal." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Batteriets egen temperatur. Omkring 35 °C under opladning er normalt."
          }
        }
      }
    },
    "The battery's temperature." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Batteriets temperatur."
          }
        }
      }
    },
    "The charge dims a little and comes back, slowly." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opladningen dæmpes lidt og kommer langsomt tilbage."
          }
        }
      }
    },
    "The charge ripples like a liquid as it rises. Moves all the time." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opladningen bølger som en væske, mens den stiger. Bevæger sig hele tiden."
          }
        }
      }
    },
    "The charger can't keep up" : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opladeren kan ikke følge med"
          }
        }
      }
    },
    "The charger the Mac is plugged into." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opladeren, som Mac’en er sluttet til."
          }
        }
      }
    },
    "The charts, the apps that used the most battery and what's usual for this Mac start again from now." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diagrammerne, de apps, der brugte mest batteri, og hvad der er normalt for denne Mac, starter forfra fra nu."
          }
        }
      }
    },
    "The core of macOS: memory, files, devices, and keeping the Mac cool." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kernen i macOS: hukommelse, filer, enheder og at holde Mac'en kølig."
          }
        }
      }
    },
    "the day" : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "dagen"
          }
        }
      }
    },
    "The edge of the charge pulses softly." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanten af opladningen pulserer blødt."
          }
        }
      }
    },
    "The Last 7 Days" : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De sidste 7 dage"
          }
        }
      }
    },
    "The last sleep and how much it used, and what's keeping the Mac awake." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den seneste dvale og hvor meget den brugte, og hvad der holder Mac'en vågen."
          }
        }
      }
    },
    "The last sleep, and what's keeping the Mac awake." : {
      "extractionState" : "stale",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den seneste dvale, og hvad der holder Mac'en vågen."
          }
        }
      }
    },
    "The liquid at rest, tilting very slowly. Moves all the time." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Væsken i ro, der hælder meget langsomt. Bevæger sig hele tiden."
          }
        }
      }
    },
    "The liquid slows to a gentle sway. Moves all the time." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Væsken falder til ro i en blid bølgen. Bevæger sig hele tiden."
          }
        }
      }
    },
    "The Mac drew %@ on average, up to %@" : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac’en brugte %1$@ i gennemsnit, op til %2$@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The Mac drew %1$@ on average, up to %2$@"
          }
        }
      }
    },
    "The Mac drew %@ on average." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac’en brugte %@ i gennemsnit."
          }
        }
      }
    },
    "The Mac drew about %@" : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac’en brugte omkring %@"
          }
        }
      }
    },
    "The Mac is plugged in, and the battery isn't charging." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac'en er tilsluttet strøm, og batteriet oplades ikke."
          }
        }
      }
    },
    "The Mac is plugged in." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac'en er tilsluttet."
          }
        }
      }
    },
    "The menu bar, how it moves, the panel and notifications, one step at a time." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menulinjen, bevægelserne, panelet og notifikationerne, ét trin ad gangen."
          }
        }
      }
    },
    "The menu bar's Control Center and its controls." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontrolcenter i menulinjen og dets knapper."
          }
        }
      }
    },
    "The period before as a dashed line, and how much each number changed." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perioden før som en stiplet linje, og hvor meget hvert tal har ændret sig."
          }
        }
      }
    },
    "The plug gives a soft double beat every few seconds." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stikket slår et blødt dobbeltslag med få sekunders mellemrum."
          }
        }
      }
    },
    "The screen, Wi‑Fi and the parts of macOS with no slice of their own." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skærmen, Wi‑Fi og de dele af macOS, der ikke har deres eget stykke."
          }
        }
      }
    },
    "The screen's backlight, Wi‑Fi, memory, storage and the rest of the hardware: macOS reports them together, not one by one. A dimmer screen makes this smaller." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skærmens baggrundslys, Wi‑Fi, hukommelse, lager og resten af hardwaren: macOS opgiver dem samlet, ikke hver for sig. En mørkere skærm gør det mindre."
          }
        }
      }
    },
    "The shortcut “%@” didn't run. Check it's in the Shortcuts app with this name." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genvejen “%@” kørte ikke. Tjek, at den findes i Genveje med dette navn."
          }
        }
      }
    },
    "The whole history, charging and battery health are in" : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hele historikken, opladning og batteritilstand findes under"
          }
        }
      }
    },
    "Their battery, next to your accessories." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deres batteri, ved siden af dit tilbehør."
          }
        }
      }
    },
    "There's no history for this app any more." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der er ikke længere nogen historik for denne app."
          }
        }
      }
    },
    "This Mac" : {
      "extractionState" : "stale",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne Mac"
          }
        }
      }
    },
    "This Mac can't switch Low Power Mode." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne Mac kan ikke skifte strømsparetilstand."
          }
        }
      }
    },
    "This Mac doesn't have a battery." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne Mac har ikke et batteri."
          }
        }
      }
    },
    "This Mac has no battery." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne Mac har intet batteri."
          }
        }
      }
    },
    "This Week" : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne uge"
          }
        }
      }
    },
    "This week's battery use shows here once the Mac has been on battery." : {
      "localizations" : {

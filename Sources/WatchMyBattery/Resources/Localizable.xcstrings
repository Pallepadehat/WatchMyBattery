    "About %lld times as much as at this time on most days, mostly because of %@." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ca. %1$lld gange så meget som på dette tidspunkt de fleste dage, mest på grund af %2$@."
          }
        }
      }
    },
    "About %lld times as much as at this time on most days." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ca. %lld gange så meget som på dette tidspunkt de fleste dage."
          }
        }
      }
    },
    "About 1% an hour or less is normal asleep on battery." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omkring 1 % i timen eller mindre er normalt i dvale på batteri."
          }
        }
      }
    },
    "About how long the battery was at 38 °C or above, where charging slows down and wear adds up." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omtrent hvor længe batteriet var på 38 °C eller derover, hvor opladningen går langsommere og slitagen tager til."
          }
        }
      }
    },
    "About how much of a full battery it used." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omtrent hvor meget af et fuldt batteri den brugte."

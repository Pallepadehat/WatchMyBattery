            "value" : "24 timer"
          }
        }
      }
    },
    "24 hours and 10 days, and the apps that used the most." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "24 timer og 10 dage, og de apps, der brugte mest."
          }
        }
      }
    },
    "24H" : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "24 t"
          }
        }

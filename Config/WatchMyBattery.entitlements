<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The hardened runtime's Calendars resource access, for "charge before your meeting". macOS still asks the
	     user first, and only once the warning is turned on in Settings › Notifications. -->
	<key>com.apple.security.personal-information.calendars</key>
	<true/>
	<!-- The container shared with the widgets (WidgetPublisher writes their state there). The team's prefix, rather
	     than "group.", needs no provisioning profile on macOS. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(TeamIdentifierPrefix)com.pallepadehat.WatchMyBattery</string>
	</array>
</dict>
</plist>
